---
interface Props { size?: number; class?: string; }
const { size = 24, class: className = '' } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  aria-hidden="true"
  role="img"
>
  <!-- Bread & roses: a stylized rose at center, flanked by two wheat ears
       arching upward like a heraldic crest. The labor-movement cry —
       sustenance and beauty, material sufficiency and dignity — rendered
       small enough to sit beside the wordmark. -->
  <g stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none">
    <!-- Rose: outer bloom, two inner petal arcs, center stamen -->
    <path d="M32 16 C 25 18, 23 26, 27 31 C 30 33, 34 33, 37 31 C 41 26, 39 18, 32 16 Z" />
    <path d="M27 23 Q 32 21 37 23" />
    <path d="M27 28 Q 32 26 37 28" />
    <circle cx="32" cy="25" r="1.4" fill="currentColor" />
    <!-- Stem dropping just below the bloom -->
    <path d="M32 33 V 38" />
    <!-- Tiny leaf pair on stem -->
    <path d="M32 35 Q 28 34 27 36" />
    <path d="M32 35 Q 36 34 37 36" />

    <!-- Left wheat ear: arching out and up like a wing -->
    <path d="M22 40 Q 14 32 13 18" />
    <line x1="14" y1="22" x2="18" y2="20" />
    <line x1="13" y1="28" x2="17" y2="26" />
    <line x1="14" y1="34" x2="18" y2="32" />

    <!-- Right wheat ear -->
    <path d="M42 40 Q 50 32 51 18" />
    <line x1="50" y1="22" x2="46" y2="20" />
    <line x1="51" y1="28" x2="47" y2="26" />
    <line x1="50" y1="34" x2="46" y2="32" />

    <!-- Ribbon binding under the rose, connecting the two wheat stalks -->
    <path d="M22 42 Q 32 46 42 42" />
    <path d="M22 42 Q 32 44 42 42" stroke-opacity="0.5" />
  </g>
</svg>
<style>
  svg { color: var(--terracotta); }
</style>
