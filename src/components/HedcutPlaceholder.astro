---
interface Props {
  name: string;
  size?: number;
  seed?: number;
  class?: string;
}

const { name, size = 120, seed: seedOverride, class: className = '' } = Astro.props;
const seed = seedOverride ?? Array.from(name).reduce((a, c) => a + c.charCodeAt(0), 0);

const rand = (n: number, salt = 0) => {
  const x = Math.sin(seed * 9301 + n * 49297 + salt * 233280) * 10000;
  return x - Math.floor(x);
};

// Build cross-hatched portrait silhouette: oval head + collar + hatching inside
const headCx = 60;
const headCy = 56;
const headRx = 30;
const headRy = 36;

const hatchLines: { x1: number; y1: number; x2: number; y2: number; w: number }[] = [];
const lineCount = 22;
for (let i = 0; i < lineCount; i++) {
  const y = headCy - headRy + (i / (lineCount - 1)) * (headRy * 2);
  // chord half-length at this y for the ellipse
  const t = (y - headCy) / headRy;
  const half = headRx * Math.sqrt(Math.max(0, 1 - t * t));
  if (half < 1) continue;
  const jitter = rand(i, 1) * 1.3;
  hatchLines.push({
    x1: headCx - half + jitter,
    y1: y,
    x2: headCx + half - jitter,
    y2: y + (rand(i, 2) - 0.5) * 0.8,
    w: 0.45 + rand(i, 3) * 0.5,
  });
}

// Suggest hair / brow with darker arcs in upper third
const browY = headCy - headRy * 0.45;
const initials = name
  .split(' ')
  .filter(Boolean)
  .map((n) => n[0])
  .slice(0, 2)
  .join('');
---

<svg
  viewBox="0 0 120 140"
  width={size}
  height={(size * 140) / 120}
  xmlns="http://www.w3.org/2000/svg"
  class={`hedcut ${className}`}
  role="img"
  aria-label={`Stylized portrait of ${name}`}
>
  <defs>
    <clipPath id={`clip-${seed}`}>
      <ellipse cx={headCx} cy={headCy} rx={headRx} ry={headRy} />
    </clipPath>
  </defs>

  <!-- collar / shoulders -->
  <path
    d={`M 18 140 Q 30 110 ${headCx - 14} ${headCy + headRy - 4} Q ${headCx} ${headCy + headRy + 6} ${headCx + 14} ${headCy + headRy - 4} Q 90 110 102 140 Z`}
    fill="none"
    stroke="currentColor"
    stroke-width="0.9"
  />

  <!-- head outline -->
  <ellipse
    cx={headCx}
    cy={headCy}
    rx={headRx}
    ry={headRy}
    fill="none"
    stroke="currentColor"
    stroke-width="1"
  />

  <!-- hatching inside head -->
  <g clip-path={`url(#clip-${seed})`} stroke="currentColor" stroke-linecap="round" opacity="0.78">
    {hatchLines.map((l) => (
      <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} stroke-width={l.w} />
    ))}
  </g>

  <!-- brow arc -->
  <path
    d={`M ${headCx - 14} ${browY + (rand(99, 4) - 0.5) * 1.5} Q ${headCx} ${browY - 6} ${headCx + 14} ${browY + (rand(99, 5) - 0.5) * 1.5}`}
    fill="none"
    stroke="currentColor"
    stroke-width="1.2"
  />

  <!-- subtle initials watermark in collar -->
  <text
    x="60"
    y="132"
    text-anchor="middle"
    font-family="Cormorant Garamond, Georgia, serif"
    font-size="8"
    letter-spacing="2"
    fill="currentColor"
    opacity="0.55"
  >
    {initials.toUpperCase()}
  </text>
</svg>

<style>
  .hedcut { color: var(--ink); }
</style>
