---
import { withBase } from '../lib/site';

const heroImg = withBase('/hero/Firefly_Gemini%20Flash_An%20editorial%20pen-and-ink%20illustration%20in%20the%20style%20of%20a%20vintage%20Wall%20Street%20Journal%20h%20558999.png');
---

<section class="border-b border-umber-300/15 overflow-hidden">
  <div class="container-wide pt-10 md:pt-20 pb-14 md:pb-24 grid md:grid-cols-12 gap-10 md:gap-14 items-center">
    <!-- Text column: headline + intro + CTAs -->
    <div class="md:col-span-7 order-2 md:order-1">
      <p class="smallcaps mb-5 md:mb-6">Episode 300 + a movement</p>
      <h1 class="!text-[clamp(2.5rem,6.5vw,5rem)] !leading-[1.04] mb-6 md:mb-8 text-umber-300">
        How do we live well<br />
        <span class="italic font-serif text-terracotta-500">in the age of the Machine?</span>
      </h1>
      <p class="font-serif text-lg md:text-xl leading-relaxed text-umber-100 max-w-prose">
        A pluralistic conversation with farmers, builders, repairers, scholars, and parents
        building human-scale alternatives — clear-eyed about systemic fragility,
        rooted in the practical work of bread and roses.
      </p>
      <div class="mt-8 md:mt-10 flex flex-wrap gap-3">
        <a href={withBase('/episodes')} class="btn btn-primary">Listen to episodes</a>
        <a href={withBase('/about')} class="btn">What is Doomer Optimism?</a>
      </div>
    </div>

    <!-- Image column: framed illustration plate -->
    <figure class="md:col-span-5 order-1 md:order-2 m-0">
      <div class="hero-plate">
        <img
          src={heroImg}
          alt="Pen-and-ink illustration: mountains, orchards, and a rising sun in the foreground; weathered turbines and smokestacks dissolving into the alpine ridgeline behind."
          loading="eager"
          width="1376"
          height="768"
        />
      </div>
      <figcaption class="hero-caption">
        <span class="smallcaps">Plate I</span>
        <span class="font-serif italic text-umber-100"> — A horizon, after the Machine</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero-plate {
    /* A printed plate mounted on parchment: thin double-rule frame with a
       narrow inner mat, then the illustration inside. */
    background: var(--paper);
    border: 1px solid rgba(42, 33, 23, 0.28);
    padding: 0.55rem;
    box-shadow: 0 12px 38px rgba(42, 33, 23, 0.08), 0 2px 8px rgba(42, 33, 23, 0.06);
    position: relative;
  }
  .hero-plate::before {
    /* The inner hairline rule that gives the printed-plate feel */
    content: '';
    position: absolute;
    inset: 0.3rem;
    border: 1px solid rgba(42, 33, 23, 0.12);
    pointer-events: none;
  }
  .hero-plate img {
    display: block;
    width: 100%;
    height: auto;
    filter: saturate(0.95) contrast(0.98);
  }
  .hero-caption {
    margin-top: 0.85rem;
    text-align: center;
    line-height: 1.4;
  }
  .hero-caption .smallcaps {
    margin-right: 0.25em;
  }
</style>
