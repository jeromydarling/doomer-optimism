---
import { site, withBase } from '../lib/site';
import Ornament from './Ornament.astro';

const heroImg = withBase('/hero/Firefly_Gemini%20Flash_An%20editorial%20pen-and-ink%20illustration%20in%20the%20style%20of%20a%20vintage%20Wall%20Street%20Journal%20h%20558999.png');
---

<section class="relative overflow-hidden border-b border-umber-300/15">
  <!-- Background imagery: the WSJ-hedcut-style mountain illustration. Sits to
       the right; a parchment gradient fades it out under the headline so text
       stays legible. On mobile we drop it to a faint underlay so the title
       gets the room. -->
  <div
    aria-hidden="true"
    class="hero-bg absolute inset-0 pointer-events-none"
    style={`background-image: url('${heroImg}');`}
  ></div>
  <div aria-hidden="true" class="hero-fade absolute inset-0 pointer-events-none"></div>

  <div class="container-wide pt-16 md:pt-28 pb-20 md:pb-32 relative">
    <div class="max-w-3xl">
      <p class="smallcaps mb-6 flex items-center gap-3">
        <Ornament size={20} />
        Episode 300 + a movement
      </p>
      <h1 class="!text-[clamp(2.75rem,8vw,6rem)] !leading-[1.02] mb-8 text-umber-300">
        How do we live well<br />
        <span class="italic font-serif text-terracotta-500">in the age of the Machine?</span>
      </h1>
      <p class="font-serif text-xl md:text-2xl leading-relaxed text-umber-100 max-w-2xl">
        A pluralistic conversation with farmers, builders, repairers, scholars, and parents
        building human-scale alternatives — clear-eyed about systemic fragility,
        rooted in the practical work of bread and roses.
      </p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href={withBase('/episodes')} class="btn btn-primary">Listen to episodes</a>
        <a href={withBase('/about')} class="btn">What is Doomer Optimism?</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-bg {
    background-repeat: no-repeat;
    /* Center-right anchor on desktop so the mountain/turbines stay visible
       while the dawn-sky negative space falls under the headline. */
    background-position: right center;
    background-size: cover;
    opacity: 0.55;
    /* Subtle warm cast keeps the parchment palette unified */
    filter: saturate(0.85) contrast(0.96);
    mix-blend-mode: multiply;
  }

  .hero-fade {
    /* Two stacked gradients: a strong parchment wash from the left
       (so the headline always sits on clean ground), and a soft top-to-bottom
       fade so the section meets the page rule cleanly. */
    background:
      linear-gradient(
        to right,
        var(--paper) 0%,
        rgba(244, 236, 219, 0.96) 18%,
        rgba(244, 236, 219, 0.6) 40%,
        rgba(244, 236, 219, 0.15) 70%,
        rgba(244, 236, 219, 0) 100%
      ),
      linear-gradient(
        to bottom,
        rgba(244, 236, 219, 0) 0%,
        rgba(244, 236, 219, 0) 70%,
        rgba(244, 236, 219, 0.4) 100%
      );
  }

  /* Mobile: smaller screens can't hold the whole image legibly behind text,
     so we fade it harder and shift the focal point. */
  @media (max-width: 767px) {
    .hero-bg {
      opacity: 0.32;
      background-position: 70% center;
    }
    .hero-fade {
      background:
        linear-gradient(
          to right,
          var(--paper) 0%,
          rgba(244, 236, 219, 0.94) 35%,
          rgba(244, 236, 219, 0.55) 70%,
          rgba(244, 236, 219, 0.2) 100%
        ),
        linear-gradient(
          to bottom,
          rgba(244, 236, 219, 0) 0%,
          rgba(244, 236, 219, 0) 65%,
          rgba(244, 236, 219, 0.5) 100%
        );
    }
  }
</style>
