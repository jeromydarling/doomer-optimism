---
import { withBase } from '../lib/site';

const heroImg = withBase('/hero/Firefly_Gemini%20Flash_An%20editorial%20pen-and-ink%20illustration%20in%20the%20style%20of%20a%20vintage%20Wall%20Street%20Journal%20h%20558999.png');
---

<section class="hero">
  <div class="hero-frame">
    <img
      class="hero-bg"
      src={heroImg}
      alt="Pen-and-ink illustration: orchards and a rising sun in the foreground; weathered turbines and smokestacks dissolving into the alpine ridgeline behind."
      loading="eager"
      width="1376"
      height="768"
    />
    <div class="hero-overlay">
      <h1 class="hero-headline">
        How do we live well<br />
        <em>in the age of the Machine?</em>
      </h1>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }

  .hero-frame {
    position: relative;
    max-width: 1376px;
    margin: 0 auto;
  }

  .hero-bg {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    padding-inline: clamp(1.25rem, 5%, 4rem);
    pointer-events: none;
  }

  .hero-headline {
    font-family: 'Cormorant Garamond', Garamond, serif;
    font-weight: 500;
    font-size: clamp(1.75rem, 4.6vw, 4.5rem);
    line-height: 1.04;
    letter-spacing: -0.005em;
    color: var(--ink);
    max-width: 50%;
    margin: 0;
    pointer-events: auto;
    /* Slight text shadow to keep the headline readable when stippled
       sun rays from the illustration cross behind it. */
    text-shadow: 0 1px 0 rgba(244, 236, 219, 0.75);
  }

  .hero-headline em {
    font-style: italic;
    color: var(--terracotta);
    display: block;
    margin-top: 0.05em;
  }

  /* Mobile: at small widths the image gets too small to host overlaid
     text legibly. Drop the headline below the image instead. */
  @media (max-width: 639px) {
    .hero-overlay {
      position: static;
      padding: 1.5rem 1.25rem 0.5rem;
      align-items: flex-start;
    }
    .hero-headline {
      max-width: 100%;
      font-size: clamp(2rem, 7.5vw, 2.5rem);
      text-shadow: none;
    }
  }
</style>
