---
import { withBase } from '../lib/site';

// Note: /contributors is intentionally not in the main nav — Ashley wants
// to confirm each contributor's role and recurrence before featuring the
// page. Individual contributor pages remain reachable from episode pages,
// the page just isn't promoted in the nav until she signs off.
const links = [
  { href: '/episodes', label: 'Episodes' },
  { href: '/pillars', label: 'Pillars' },
  { href: '/library', label: 'Library' },
  { href: '/events', label: 'Events' },
  { href: '/about', label: 'About' },
];

const path = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => {
  const target = withBase(href).replace(/\/$/, '');
  return path === target || path.startsWith(target + '/');
};
---

<header class="border-b border-umber-300/15 bg-parchment-100/70 backdrop-blur-sm sticky top-0 z-40">
  <div class="container-wide flex items-center justify-between gap-4 py-4 md:py-5">
    <a href={withBase('/')} class="!border-b-0 group">
      <span class="wordmark text-[1.45rem] md:text-[1.7rem]" aria-label="Doomer Optimism">
        <span class="wordmark-doomer">Doomer</span><span class="wordmark-optimism">Optimism</span>
      </span>
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-3 lg:gap-4">
        {links.map((l) => (
          <li>
            <a
              href={withBase(l.href)}
              class={`!border-b-0 smallcaps !text-[0.66rem] !tracking-[0.14em] hover:!text-terracotta-500 transition-colors ${
                isActive(l.href) ? '!text-terracotta-500' : '!text-umber-200'
              }`}
            >
              {l.label}
            </a>
          </li>
        ))}
        <li>
          <a href={withBase('/newsletter')} class="btn !py-1.5 !px-2.5 !text-[0.62rem] !tracking-[0.14em] !border-b !border-umber-300">
            Subscribe
          </a>
        </li>
      </ul>
    </nav>

    <button
      type="button"
      aria-label="Open menu"
      aria-controls="mobile-nav"
      aria-expanded="false"
      class="md:hidden inline-flex flex-col gap-1.5 p-2 -m-2"
      data-menu-toggle
    >
      <span class="block h-px w-6 bg-umber-300"></span>
      <span class="block h-px w-6 bg-umber-300"></span>
      <span class="block h-px w-6 bg-umber-300"></span>
    </button>
  </div>

  <!--
    Mobile nav is absolutely positioned beneath the header bar so that
    opening it overlays the page content rather than expanding the
    header in flow and pushing the hero image down.
  -->
  <nav
    id="mobile-nav"
    aria-label="Mobile"
    class="md:hidden hidden absolute top-full inset-x-0 border-t border-umber-300/15 bg-parchment-50 shadow-[0_18px_32px_rgba(42,33,23,0.12)]"
  >
    <ul class="container-wide py-4 flex flex-col gap-2">
      {links.map((l) => (
        <li>
          <a href={withBase(l.href)} class="!border-b-0 block py-2 font-display text-2xl text-umber-300 hover:text-terracotta-500">
            {l.label}
          </a>
        </li>
      ))}
      <li class="pt-3">
        <a href={withBase('/newsletter')} class="btn btn-primary block text-center">Subscribe</a>
      </li>
    </ul>
  </nav>
</header>

<script is:inline>
  (function () {
    const btn = document.querySelector('[data-menu-toggle]');
    const nav = document.getElementById('mobile-nav');
    if (!btn || !nav) return;
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      nav.classList.toggle('hidden');
    });
  })();
</script>
