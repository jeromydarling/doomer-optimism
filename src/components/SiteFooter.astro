---
import { site, withBase } from '../lib/site';
import Ornament from './Ornament.astro';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-umber-300/15 bg-parchment-50/60">
  <div class="container-wide py-14 grid gap-12 md:grid-cols-4">
    <div class="md:col-span-2 max-w-md">
      <div class="flex items-center gap-3 mb-4">
        <Ornament size={28} />
        <span class="wordmark text-[1.4rem]" aria-label="Doomer Optimism">
          <span class="wordmark-doomer">Doomer</span><span class="wordmark-optimism">Optimism</span>
        </span>
      </div>
      <p class="text-umber-100 leading-relaxed">
        A pluralistic conversation hosted by Ashley Colby Fitzgerald. Clear-eyed about the Machine,
        rooted in the practical work of building human-scale alternatives.
      </p>
      <p class="smallcaps mt-6">Brought to you by</p>
      <a href={site.sponsor.href} class="font-display text-xl !border-b-0 hover:!text-terracotta-500 text-umber-300">
        {site.sponsor.name} <span class="text-umber-100 font-serif italic text-base">— {site.sponsor.tagline}</span>
      </a>
    </div>

    <div>
      <p class="smallcaps mb-3">Listen & Watch</p>
      <ul class="space-y-2">
        <li><a href={site.social.youtube}>YouTube</a></li>
        <li><a href={site.social.spotify}>Spotify / Anchor</a></li>
        <li><a href={site.social.apple}>Apple Podcasts</a></li>
        <li><a href={site.social.substack}>Substack</a></li>
        <li><a href={site.social.twitter}>X / Twitter</a></li>
      </ul>
    </div>

    <div>
      <p class="smallcaps mb-3">Explore</p>
      <ul class="space-y-2">
        <li><a href={withBase('/episodes')}>All episodes</a></li>
        <li><a href={withBase('/pillars')}>Six pillars</a></li>
        <li><a href={withBase('/library')}>Research library</a></li>
        <li><a href={withBase('/contributors')}>Contributors</a></li>
        <li><a href={withBase('/events')}>Events</a></li>
        <li><a href={withBase('/newsletter')}>Newsletter</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-umber-300/15">
    <div class="container-wide py-6 flex flex-col md:flex-row items-center justify-between gap-3 text-umber-100 text-sm">
      <p>© {year} Doomer Optimism · Rizoma Field School</p>
      <p class="smallcaps">Bread & roses · Sustenance & beauty</p>
    </div>
  </div>
</footer>
