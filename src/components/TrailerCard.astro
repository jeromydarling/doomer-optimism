---
// Click-to-load trailer card. The poster is fetched up front (~150KB)
// but the 89MB MP4 only loads when the visitor clicks play. Same facade
// pattern as YouTubeEmbed.astro; deliberately styled like a piece of
// editorial signage rather than a YouTube player.
export interface Props {
  videoUrl: string;
  posterUrl: string;
  caption?: string;
  /** Aspect ratio override (default 16/9). */
  aspect?: string;
}
const {
  videoUrl,
  posterUrl,
  caption = 'Watch the trailer · 60 seconds',
  aspect = '16/9',
} = Astro.props;
---

<figure class="trailer" data-video={videoUrl} style={`aspect-ratio: ${aspect}`}>
  <button class="trailer-facade" type="button" aria-label={`Play: ${caption}`}>
    <img
      class="trailer-poster"
      src={posterUrl}
      alt="Promo poster — The Angelus by Jean-François Millet, with the show wordmark overlaid."
      loading="lazy"
      decoding="async"
    />
    <span class="trailer-vignette" aria-hidden="true"></span>
    <span class="trailer-caption">{caption}</span>
    <span class="trailer-play" aria-hidden="true">
      <svg width="72" height="72" viewBox="0 0 72 72" fill="none">
        <circle cx="36" cy="36" r="36" fill="rgba(20,14,8,0.78)"></circle>
        <path d="M29 23v26l20-13z" fill="#f4eddb"></path>
      </svg>
    </span>
  </button>
</figure>

<style>
  .trailer {
    position: relative;
    width: 100%;
    background: #1a140a;
    overflow: hidden;
    border: 1px solid var(--rule, rgba(60,45,30,0.18));
    margin: 0;
  }

  .trailer-facade {
    position: absolute;
    inset: 0;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    width: 100%;
    height: 100%;
    display: block;
  }

  .trailer-poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: contrast(0.96) saturate(0.85);
    transition: filter 220ms ease;
  }
  .trailer-facade:hover .trailer-poster,
  .trailer-facade:focus-visible .trailer-poster {
    filter: none;
  }

  .trailer-vignette {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at center, rgba(13,10,6,0) 35%, rgba(13,10,6,0.55) 80%, rgba(13,10,6,0.85) 100%),
      linear-gradient(180deg, rgba(13,10,6,0) 60%, rgba(13,10,6,0.55) 100%);
    pointer-events: none;
  }

  .trailer-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.4rem 1.75rem 1.2rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: #f4eddb;
    text-align: left;
    pointer-events: none;
  }

  .trailer-play {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    transition: transform 200ms ease;
  }
  .trailer-facade:hover .trailer-play,
  .trailer-facade:focus-visible .trailer-play {
    transform: translate(-50%, -50%) scale(1.06);
  }

  .trailer.is-playing .trailer-facade {
    display: none;
  }
  .trailer video {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.trailer').forEach((el) => {
    const btn = el.querySelector<HTMLButtonElement>('.trailer-facade');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const url = el.dataset.video;
      if (!url) return;
      const v = document.createElement('video');
      v.src = url;
      v.controls = true;
      v.autoplay = true;
      v.playsInline = true;
      v.preload = 'metadata';
      el.appendChild(v);
      el.classList.add('is-playing');
    });
  });
</script>
