---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EpisodeCard from '../../components/EpisodeCard.astro';
import { withBase } from '../../lib/site';

export async function getStaticPaths() {
  const pillars = await getCollection('pillars');
  return pillars.map((p) => ({ params: { slug: p.slug }, props: { entry: p } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const allEpisodes = (await getCollection('episodes', (e) => !e.data.draft))
  .filter((e) => e.data.pillar.slug === entry.slug || e.data.secondaryPillar?.slug === entry.slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const articles = await getCollection('articles', (a) => a.data.pillar.slug === entry.slug);
---

<BaseLayout title={entry.data.title} description={entry.data.blurb}>
  <div class="container-wide pt-12 md:pt-20 pb-6">
    <p class="smallcaps mb-3">
      <a href={withBase('/pillars')} class="!border-b-0 hover:!text-terracotta-500">All pillars</a>
    </p>
    <h1>{entry.data.title}</h1>
    <p class="font-serif text-xl text-umber-100 max-w-3xl mt-5">{entry.data.blurb}</p>
  </div>

  <div class="container-wide pt-4 pb-12">
    <div class="prose-content max-w-prose">
      <Content />
    </div>
  </div>

  <section class="container-wide pb-12">
    <p class="smallcaps mb-3">Episodes in this pillar</p>
    <h2 class="!text-2xl mb-6">{allEpisodes.length} conversation{allEpisodes.length === 1 ? '' : 's'}</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
      {allEpisodes.map((e) => <EpisodeCard episode={e} />)}
    </div>
  </section>

  {articles.length > 0 && (
    <section class="container-wide pb-24">
      <p class="smallcaps mb-3">Companion essays</p>
      <h2 class="!text-2xl mb-6">From the research library</h2>
      <ul class="grid md:grid-cols-2 gap-8">
        {articles.map((a) => (
          <li>
            <a href={withBase(`/library/${a.slug}`)} class="!border-b-0 group block">
              <h3 class="!text-xl !text-umber-300 group-hover:!text-terracotta-500 leading-snug mb-1">{a.data.title}</h3>
              {a.data.subtitle && <p class="italic text-umber-100">{a.data.subtitle}</p>}
              <p class="smallcaps mt-2">{a.data.author} · {a.data.readingMinutes} min</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
