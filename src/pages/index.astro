---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import EpisodeCard from '../components/EpisodeCard.astro';
import PillarCard from '../components/PillarCard.astro';
import ContributorCard from '../components/ContributorCard.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import { withBase, site, excerpt } from '../lib/site';

const allEpisodesIncludingDrafts = (await getCollection('episodes'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const allEpisodes = allEpisodesIncludingDrafts.filter((e) => !e.data.draft);
// Most recent published episode that has a YouTube ID set — used for
// the homepage video band. Drafts are excluded because their Haiku-
// generated summaries frequently mis-attribute the guest as the host.
const latestWithVideo = allEpisodes.find((e) => e.data.youtubeId);

// Featured episode: explicit `featured: true` only — no implicit fallback
// to "most recent". Implicit fallbacks caused the homepage to feature a
// scaffold placeholder when the real featured episode was deleted.
const featured = allEpisodes.find((e) => e.data.featured);
const recent = allEpisodes
  .filter((e) => !featured || e.id !== featured.id)
  .filter((e) => !latestWithVideo || e.id !== latestWithVideo.id)
  .slice(0, 6);

const pillars = (await getCollection('pillars')).sort((a, b) => a.data.order - b.data.order);
const pillarCounts = Object.fromEntries(
  pillars.map((p) => [
    p.slug,
    allEpisodes.filter(
      (e) => e.data.pillar.slug === p.slug || e.data.secondaryPillar?.slug === p.slug,
    ).length,
  ]),
);

const contributors = (await getCollection('contributors', (c) => c.data.featured));
---

<BaseLayout>
  <Hero />

  {latestWithVideo && (
    <section class="container-wide pt-10 md:pt-14 pb-4">
      <div class="flex items-baseline justify-between gap-4 mb-4">
        <p class="smallcaps">Latest episode · No. {latestWithVideo.data.number}</p>
        <a
          href={withBase(`/episodes/${latestWithVideo.slug}`)}
          class="smallcaps !text-[0.62rem] !border-b-0 hover:!text-terracotta-500 hidden sm:inline"
        >
          Episode notes →
        </a>
      </div>
      <div class="grid md:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] gap-x-10 gap-y-6 items-start">
        <YouTubeEmbed
          videoId={latestWithVideo.data.youtubeId!}
          title={latestWithVideo.data.title}
        />
        {latestWithVideo.data.summary && (
          <div>
            <h3 class="font-display text-2xl md:text-[1.75rem] text-umber-300 leading-snug mb-3">
              <a
                href={withBase(`/episodes/${latestWithVideo.slug}`)}
                class="!border-b-0 hover:!text-terracotta-500"
              >
                {latestWithVideo.data.title}
              </a>
            </h3>
            <p class="font-serif text-base md:text-[1.05rem] leading-relaxed text-umber-100">
              {excerpt(latestWithVideo.data.summary, 280)}
              {' '}
              <a
                href={withBase(`/episodes/${latestWithVideo.slug}`)}
                class="smallcaps !text-[0.62rem] !border-b-0 hover:!text-terracotta-500 align-middle"
              >
                Read more →
              </a>
            </p>
          </div>
        )}
      </div>
    </section>
  )}

  {featured && (
    <section class="container-wide pt-14 md:pt-20">
      <div class="rule-ornament mb-8">
        <span class="smallcaps">Latest · Episode {featured.data.number}</span>
      </div>
      <EpisodeCard episode={featured} variant="feature" />
    </section>
  )}

  <section class="mt-20 bg-umber-300 border-y border-umber-400/40">
    <div class="container-wide py-16 md:py-20">
      <div class="flex items-baseline justify-between gap-4 mb-3">
        <h2 class="!text-3xl md:!text-4xl !text-parchment-100">Six arenas for living well</h2>
        <a href={withBase('/pillars')} class="smallcaps !text-parchment-400 !border-b-0 hover:!text-terracotta-400 hidden sm:inline">All pillars →</a>
      </div>
      <p class="text-parchment-300/80 max-w-prose mb-10">
        The conversation organizes around six interlocking domains, each with its own
        practitioners and slow-built reading list.
      </p>
      <div class="grid md:grid-cols-2 gap-3">
        {pillars.map((p) => (
          <div class="bg-parchment-100">
            <PillarCard pillar={p} episodeCount={pillarCounts[p.slug]} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="container-wide pt-20">
    <div class="flex items-baseline justify-between gap-4 mb-8">
      <h2 class="!text-3xl md:!text-4xl">Recent episodes</h2>
      <a href={withBase('/episodes')} class="smallcaps !border-b-0 hover:!text-terracotta-500 hidden sm:inline">All episodes →</a>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
      {recent.map((e) => <EpisodeCard episode={e} />)}
    </div>
    <div class="mt-10 text-center sm:hidden">
      <a href={withBase('/episodes')} class="btn">All episodes</a>
    </div>
  </section>

  <section class="container-wide pt-24">
    <h2 class="!text-3xl md:!text-4xl mb-2">Voices of the show</h2>
    <p class="text-umber-100 max-w-prose mb-10">
      Host and recurring contributors. Each portrait is a hand-engraved hedcut in the
      tradition of the Wall Street Journal — generated as placeholders until the
      commissioned set is delivered.
    </p>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-8">
      {contributors.map((c) => <ContributorCard contributor={c} />)}
    </div>
  </section>

  <section class="mt-24 bg-umber-300 border-y border-umber-400/40">
    <div class="container-wide py-16 md:py-24 text-center">
      <p class="smallcaps !text-parchment-400 mb-3">The Newsletter</p>
      <h2 class="!text-3xl md:!text-4xl !text-parchment-100 mb-4 mx-auto max-w-2xl">Companion essays, when the moment calls for one.</h2>
      <p class="text-parchment-300/80 mx-auto mb-8 max-w-xl">
        Every once in a while we'll release a long-form essay through Substack — a 1,500–2,500 word
        deepening of an episode or a thread we keep returning to.
      </p>
      <a
        href={site.social.substack}
        class="btn !bg-terracotta-500 !text-parchment-100 !border-terracotta-500 hover:!bg-terracotta-400 hover:!border-terracotta-400 hover:!text-parchment-50"
      >
        Subscribe on Substack
      </a>
    </div>
  </section>
</BaseLayout>
