# Build output
dist/
.astro/

# Dependencies
node_modules/

# Environment
.env
.env.production
.env.local

# Editor
.vscode/
.idea/
*.swp
.DS_Store

# Logs
*.log
npm-debug.log*

# Misc
.claude/settings.local.json

# Hedcut pipeline outputs (regenerated locally)
public/_demo/*.svg
public/_demo/*.png
public/_demo/*.html

# Transcript pipeline working files. The full .transcripts/ directory
# lives only on the claude/transcripts-backfill PR branch (where the
# workflow's peter-evans add-paths commits it for durable caching). On
# main it should never be tracked — checkouts of the PR branch into
# the working tree shouldn't trigger commits to main.
.transcripts/

# Hero image build artifacts (generated from source PNG by build step)
public/hero/hero-bg.jpg
public/hero/hero-bg.webp

# Hyperframes promo: binary asset files (fetched by promo/fetch-assets.sh)
# and rendered MP4s live outside git history.
promo/assets/*.jpg
promo/assets/*.png
promo/assets/*.mp3
promo/assets/*.wav
promo/assets/*.mp4
promo/node_modules/
promo/*.mp4
promo/.hyperframes/
